{% import "OSVWissen::Partials.Antwort" as a %}
<div class="osvw osvw-kurz">
  <h2>Schnelle Hilfe</h2>
  <p>Die häufigsten Anliegen, sofort beantwortet. Passt nichts, schreiben Sie uns einfach unten.</p>
  {% for b in fragen %}
  <details id="kurz-{{ b.id }}"><summary>{{ b.frage }}</summary>{{ a.antwort(b) }}</details>
  {% endfor %}
  <a class="osvw-alle" href="{{ faqUrl }}">Alle häufigen Fragen ansehen ›</a>
</div>
