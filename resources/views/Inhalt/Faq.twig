{% import "OSVWissen::Partials.Antwort" as a %}
<div class="osvw osvw-seite" data-osvw-faq>
  <div class="osvw-hero">
    <div class="osvw-hero-text">
      <h1>Wie können wir helfen?</h1>
      <p>Antworten auf die Fragen, die uns am häufigsten erreichen. Nichts dabei? Wir sind {{ zeiten }} persönlich für Sie da.</p>
      <div class="osvw-suche"><input type="search" placeholder="Stichwort suchen, z. B. Rücksendung, Ersatzteil, Gutschein" aria-label="Häufige Fragen durchsuchen" data-osvw-suche></div>
      <div class="osvw-treffer" data-osvw-treffer aria-live="polite"></div>
    </div>
    <div class="osvw-wege" aria-label="So erreichen Sie uns">
      <button type="button" class="osvw-weg osvw-aus" data-osvw-chat><span class="osvw-weg-i"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.7A8 8 0 1 1 21 12z"/></svg></span><span class="osvw-weg-t">Chat<b>Jetzt schreiben ›</b></span></button>
      <a class="osvw-weg" href="mailto:{{ email }}" title="{{ email }}"><span class="osvw-weg-i"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span><span class="osvw-weg-t">E-Mail<b>Mail schreiben ›</b></span></a>
      <a class="osvw-weg" href="{{ kontaktUrl }}"><span class="osvw-weg-i"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg></span><span class="osvw-weg-t">Kontaktformular<b>Nachricht senden ›</b></span></a>
      <a class="osvw-weg" href="tel:{{ telefon | replace({' ': '', '-': ''}) }}"><span class="osvw-weg-i"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></span><span class="osvw-weg-t">Telefon<b>{{ telefon }}</b></span></a>
    </div>
  </div>
  <div class="osvw-koerper">
    <aside class="osvw-nav">
      <b>Themen</b>
      {% for t in themen %}<a href="#hilfe-{{ t.id }}" data-osvw-navi="{{ t.id }}">{{ t.titel }}<em>{{ t.fragen | length }}</em></a>{% endfor %}
      <div class="osvw-kontakt">
        <strong>Nicht gefunden?</strong>
        <p>Schreiben Sie uns, mit Auftragsnummer geht es schneller.</p>
        <a class="osvw-knopf" href="{{ kontaktUrl }}">Kontakt aufnehmen</a>
        <p class="osvw-tel"><a href="tel:{{ telefon | replace({' ': '', '-': ''}) }}">{{ telefon }}</a></p>
      </div>
    </aside>
    <div>
      {% for t in themen %}
      <section class="osvw-gruppe" id="hilfe-{{ t.id }}" data-osvw-gruppe="{{ t.id }}">
        <h2>{{ t.titel }}<span>{{ t.fragen | length }} {{ t.fragen | length == 1 ? 'Frage' : 'Fragen' }}</span></h2>
        {% for b in t.fragen %}
        <details id="{{ b.id }}" data-osvw-frage>
          <summary>{{ b.frage }}</summary>
          {{ a.antwort(b) }}
        </details>
        {% endfor %}
      </section>
      {% endfor %}
      {% if videoKanal %}<p class="osvw-mehrvideo">Weitere Anleitungen aus der Werkstatt: <a href="{{ videoKanal }}" target="_blank" rel="noopener">unsere Videos auf YouTube</a></p>{% endif %}
    </div>
  </div>
</div>
