{% import "OSVWissen::Partials.Antwort" as a %}
{% set customClass = widget.settings.customClass.mobile %}
{% include "OSVWissen::Partials.Stil" %}
<div class="widget osvw{% if customClass | length > 0 %} {{ customClass }}{% endif %}" data-osvw-faq>
  <div class="osvw-hero">
    <h1>Wie können wir helfen?</h1>
    <p>Antworten auf die Fragen, die uns am häufigsten erreichen. Nichts dabei? Wir sind {{ zeiten }} persönlich für Sie da.</p>
    <div class="osvw-suche"><input type="search" placeholder="Stichwort suchen, z. B. Rücksendung, Ersatzteil, Gutschein" aria-label="Häufige Fragen durchsuchen" data-osvw-suche></div>
    <div class="osvw-treffer" data-osvw-treffer aria-live="polite"></div>
  </div>
  <div class="osvw-koerper">
    <aside class="osvw-nav">
      <b>Themen</b>
      {% for t in themen %}<a href="#hilfe-{{ t.id }}" data-osvw-navi="{{ t.id }}">{{ t.titel }}<em>{{ t.fragen | length }}</em></a>{% endfor %}
      <div class="osvw-kontakt">
        <strong>Nicht gefunden?</strong>
        <p>Schreiben Sie uns, mit Auftragsnummer geht es schneller.</p>
        <a class="osvw-knopf" href="{{ kontaktUrl }}">Kontakt aufnehmen</a>
        <p class="osvw-tel"><a href="tel:{{ telefon | replace({' ': '', '-': ''}) }}">{{ telefon }}</a></p>
      </div>
    </aside>
    <div>
      {% for t in themen %}
      <section class="osvw-gruppe" id="hilfe-{{ t.id }}" data-osvw-gruppe="{{ t.id }}">
        <h2>{{ t.titel }}<span>{{ t.fragen | length }} {{ t.fragen | length == 1 ? 'Frage' : 'Fragen' }}</span></h2>
        {% for b in t.fragen %}
        <details id="{{ b.id }}" data-osvw-frage>
          <summary>{{ b.frage }}</summary>
          {{ a.antwort(b) }}
        </details>
        {% endfor %}
      </section>
      {% endfor %}
      {% if videoKanal %}<p class="osvw-mehrvideo">Weitere Anleitungen aus der Werkstatt: <a href="{{ videoKanal }}" target="_blank" rel="noopener">unsere Videos auf YouTube</a></p>{% endif %}
    </div>
  </div>
  {% if schemaJson %}<script type="application/ld+json">{{ schemaJson | raw }}</script>{% endif %}
  <script>
  (function () {
    var w = document.querySelector('[data-osvw-faq]'); if (!w) return;
    var feld = w.querySelector('[data-osvw-suche]'), anzeige = w.querySelector('[data-osvw-treffer]');
    var fragen = [].slice.call(w.querySelectorAll('[data-osvw-frage]'));
    var norm = function (s) { return s.toLowerCase().replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss'); };
    var texte = fragen.map(function (d) { return norm(d.textContent); });
    function oeffneAusAdresse() {
      var id = decodeURIComponent((location.hash || '').slice(1)); var d = id && document.getElementById(id);
      if (d && d.tagName === 'DETAILS') { d.open = true; }
    }
    feld.addEventListener('input', function () {
      var woerter = norm(feld.value).split(/\s+/).filter(function (x) { return x.length > 1; }), n = 0;
      fragen.forEach(function (d, i) {
        var passt = !woerter.length || woerter.every(function (x) { return texte[i].indexOf(x) > -1; });
        d.classList.toggle('osvw-aus', !passt); d.open = !!woerter.length && passt; if (passt) n++;
      });
      [].forEach.call(w.querySelectorAll('[data-osvw-gruppe]'), function (g) {
        var sichtbar = g.querySelectorAll('[data-osvw-frage]:not(.osvw-aus)').length;
        g.classList.toggle('osvw-aus', !sichtbar);
        var navi = w.querySelector('[data-osvw-navi="' + g.getAttribute('data-osvw-gruppe') + '"]');
        if (navi) navi.classList.toggle('osvw-aus', !sichtbar);
      });
      anzeige.textContent = woerter.length ? (n ? n + (n === 1 ? ' passende Antwort' : ' passende Antworten') : 'Keine passende Antwort. Schreiben Sie uns gern.') : '';
    });
    window.addEventListener('hashchange', oeffneAusAdresse); oeffneAusAdresse();
  })();
  </script>
</div>
