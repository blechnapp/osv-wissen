<style>
.osvw{--m:#0c2a5e;--h:#B08052;--l:#E5DFD6;--p:#FAF7F2;--t:#1C1C1C;--s:#6B6B6B;color:var(--t)}
.osvw a{color:var(--m)}
.osvw-seite{max-width:1300px;margin:28px auto 48px;padding:0 15px}
.osvw-hero{background:linear-gradient(180deg,#FFFDF9 0%,#F4EDE2 100%);border:1px solid var(--l);border-radius:8px;padding:26px 24px 30px;margin-bottom:28px;display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:32px;align-items:center}
.osvw-wege{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.osvw-weg{display:flex;align-items:center;gap:11px;min-width:0;padding:10px 12px;border:1px solid #ead9c2;border-radius:10px;background:#faf4ea;color:#4a4a4a!important;text-align:left;text-decoration:none!important;cursor:pointer;font:inherit;transition:background .15s,border-color .15s}
.osvw-weg:hover{background:#f5ead9;border-color:var(--h)}
.osvw-weg-i{flex:0 0 36px;height:36px;border-radius:50%;background:var(--m);display:flex;align-items:center;justify-content:center}
.osvw-weg-t{display:flex;flex-direction:column;min-width:0;font-size:13px;line-height:1.3}
.osvw-weg-t b{font-size:14.5px;font-weight:600;color:var(--m);white-space:nowrap}
.osvw-hero h1{font-size:clamp(28px,3.4vw,40px);color:var(--m);margin:0 0 10px}
.osvw-hero p{font-size:17px;color:#4c4c4c;max-width:62ch;margin:0 0 20px}
.osvw-suche{position:relative;max-width:640px}
.osvw-suche input{width:100%;height:52px;border:1.5px solid var(--l);border-radius:6px;background:#fff;padding:0 16px;font-size:16px;color:var(--t)}
.osvw-suche input:focus{outline:none;border-color:var(--m);box-shadow:0 0 0 3px rgba(12,42,94,.08)}
.osvw-treffer{margin-top:10px;font-size:14.5px;color:#8a5a2b;min-height:21px}
.osvw-koerper{display:grid;grid-template-columns:260px 1fr;gap:44px;align-items:start}
.osvw-nav{position:sticky;top:130px}
.osvw-nav b{display:block;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--h);margin-bottom:10px}
.osvw-nav>a{display:flex;justify-content:space-between;gap:10px;padding:8px 10px;border-radius:6px;font-size:15px;color:#3a3a3a;text-decoration:none;line-height:1.3}
.osvw-nav>a:hover{background:#fff;color:var(--m)}
.osvw-nav>a em{font-style:normal;font-size:12.5px;color:var(--s);background:var(--p);border:1px solid var(--l);border-radius:20px;padding:0 8px;flex:none;align-self:center}
.osvw-kontakt{margin-top:22px;background:#fff;border:1px solid var(--l);border-left:3px solid var(--h);border-radius:8px;padding:18px}
.osvw-kontakt strong{display:block;color:var(--m);font-size:17px;margin-bottom:6px}
.osvw-kontakt p{font-size:14.5px;color:#5a5a5a;line-height:1.5;margin:0 0 12px}
.osvw-knopf{display:block;text-align:center;background:var(--m);color:#fff!important;border-radius:5px;padding:10px 14px;font-weight:600;text-decoration:none}
.osvw-knopf:hover{background:#04305e}
.osvw-tel{text-align:center;margin:12px 0 0!important}
.osvw-tel a{font-weight:600;font-size:17px;text-decoration:none}
.osvw-gruppe{padding:0 0 34px;scroll-margin-top:130px}
.osvw-gruppe h2{font-size:24px;color:var(--m);margin:0 0 14px;display:flex;align-items:baseline;gap:12px;border-bottom:2px solid var(--l);padding-bottom:8px}
.osvw-gruppe h2 span{font-size:13.5px;font-weight:400;color:var(--s)}
.osvw details{background:#fff;border:1px solid var(--l);border-radius:8px;margin-bottom:10px;overflow:hidden}
.osvw details[open]{border-color:var(--h);box-shadow:0 6px 20px rgba(60,40,20,.09)}
.osvw summary{cursor:pointer;list-style:none;padding:15px 50px 15px 18px;position:relative;font-weight:600;font-size:17.5px;color:var(--m);line-height:1.3}
.osvw summary::-webkit-details-marker{display:none}
.osvw summary:hover{background:#FBF7F0}
.osvw summary::after{content:"";position:absolute;right:20px;top:21px;width:10px;height:10px;border-right:2px solid var(--h);border-bottom:2px solid var(--h);transform:rotate(45deg);transition:.2s}
.osvw details[open] summary::after{transform:rotate(-135deg);top:25px}
.osvw-a{padding:0 18px 18px;border-top:1px solid var(--l)}
.osvw-a p,.osvw-a li{font-size:16px;line-height:1.6;color:#3c3c3c}
.osvw-a p{margin:12px 0 0}
.osvw-a ul{margin:10px 0 0;padding-left:20px}
.osvw-a li{margin-bottom:4px}
.osvw-a a{word-break:break-word}
.osvw-video{display:inline-flex;align-items:center;gap:10px;margin-top:14px;padding:9px 14px;border:1px solid var(--l);border-radius:6px;background:var(--p);text-decoration:none;font-weight:600;font-size:15px}
.osvw-video:hover{border-color:var(--h)}
.osvw-play{width:26px;height:26px;border-radius:50%;background:var(--m);position:relative;flex:none}
.osvw-play::after{content:"";position:absolute;left:10px;top:7px;border-left:9px solid #fff;border-top:6px solid transparent;border-bottom:6px solid transparent}
.osvw-mehrvideo{margin-top:8px;font-size:14.5px}
.osvw-aus{display:none!important}
.osvw-kurz{border:1px solid var(--l);border-radius:8px;padding:18px 18px 8px;margin-bottom:24px;background:#fff}
.osvw-kurz h2{font-size:20px;color:var(--m);margin:0 0 6px}
.osvw-kurz>p{font-size:15px;color:#5a5a5a;margin:0 0 12px}
.osvw-kurz details{margin-bottom:8px}
.osvw-kurz .osvw-alle{display:inline-block;margin:6px 0 10px;font-weight:600}
@media(max-width:1100px){.osvw-hero{grid-template-columns:1fr;gap:20px}}
@media(max-width:900px){.osvw-seite{margin-top:16px}.osvw-koerper{grid-template-columns:1fr;gap:24px}.osvw-koerper{gap:0}.osvw-nav{display:contents}.osvw-nav>a{border:1px solid var(--l);background:#fff;margin-bottom:6px}.osvw-inhalt{margin-top:18px}.osvw-kontakt{order:1;margin-top:8px;display:none}.osvw-gesucht .osvw-kontakt{display:block}.osvw summary{font-size:16.5px;padding:13px 44px 13px 14px}.osvw-a{padding:0 14px 14px}.osvw-hero{padding:20px 16px 22px}}
@media(max-width:480px){.osvw-wege{gap:8px}.osvw-weg{padding:9px 8px;gap:8px}.osvw-weg-i{flex-basis:28px;height:28px}.osvw-weg-i svg{width:15px;height:15px}.osvw-weg-t{font-size:12px}.osvw-weg-t b{font-size:13px;white-space:normal}.osvw-treffer{min-height:0}.osvw-weg[href^="tel"] b{white-space:nowrap;font-size:12.5px}}
</style>
